{
  "name": "@b12k/gitleaks",
  "version": "8.30.1-v.30",
  "description": "The missing NPM wrapper for Gitleaks",
  "keywords": [
    "api-keys",
    "cli",
    "data-loss-prevention",
    "devsecops",
    "dlp",
    "files",
    "git",
    "gitleaks",
    "npm",
    "passwords",
    "secret",
    "secrets",
    "security",
    "security-tools",
    "stdin",
    "tokens",
    "wrapper"
  ],
  "license": "MIT",
  "author": "Bogdan Kolesnyk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/b12k/gitleaks.git"
  },
  "bin": {
    "gitleaks": "dist/cli.js",
    "gitleaks-install": "dist/postinstall.js"
  },
  "files": [
    "dist",
    "scripts"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rslib",
    "check": "run-p -l check:*",
    "check:format": "oxfmt . --check",
    "check:scripts": "oxlint",
    "check:types": "tsc --noEmit",
    "deps:check": "ncu -e 2 -c 1",
    "deps:update": "ncu -du --doctorTest \"pnpm deps:update:doctor\" -c 1",
    "deps:update:doctor": "run-p -l check:types check:scripts build",
    "dev": "rslib --watch",
    "fix": "run-s -l fix:*",
    "fix:format": "oxfmt . --write",
    "fix:scripts": "oxlint --fix",
    "ga:notify": "tsx .github/notify.ts",
    "ga:update-gitleaks": "tsx .github/update-gitleaks.ts",
    "husky:commit-msg": "commitlint",
    "husky:pre-commit": "lint-staged",
    "husky:pre-push": "branch-name-lint",
    "postinstall": "node scripts/postinstall.js",
    "prepack": "run-p check build",
    "prepare": "husky",
    "release": "release-it --preRelease=v"
  },
  "dependencies": {
    "boxen": "8.0.1",
    "tar": "7.5.22",
    "update-notifier": "7.3.1"
  },
  "devDependencies": {
    "@b12k/branch-name-lint": "1.3.0",
    "@commitlint/config-conventional": "21.2.2",
    "@release-it/conventional-changelog": "12.0.0",
    "@rslib/core": "0.23.2",
    "@types/node": "26.4.0",
    "@types/semver": "7.8.0",
    "@types/update-notifier": "6.0.8",
    "commitlint": "21.2.2",
    "eslint-plugin-perfectionist": "5.10.1",
    "husky": "9.1.7",
    "lint-staged": "17.4.1",
    "npm-check-updates": "23.1.0",
    "npm-run-all2": "9.0.3",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "oxlint-tsgolint": "7.0.2001",
    "release-it": "21.0.2",
    "semver": "7.8.5",
    "tsx": "4.23.12",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.24.0"
}
